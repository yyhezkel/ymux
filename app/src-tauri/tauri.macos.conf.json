{
  "$schema": "https://schema.tauri.app/config/2",
  "mainBinaryName": "ymux",
  "build": {
    "beforeBuildCommand": "npm run build:frontend"
  },
  "bundle": {
    "targets": ["app"],
    "resources": [
      "resources/ymux-cli",
      "resources/ymux-linux-x64",
      "resources/remote-manifest.json",
      "resources/ymux-tmux.conf"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-"
    }
  }
}
